{
  "name": "acme/fake-psp",
  "description": "Simulated external payment provider for the workshop",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "open-telemetry/sdk": "^1.16",
    "open-telemetry/exporter-otlp": "^1.5",
    "symfony/http-client": "^7.4",
    "nyholm/psr7": "^1.8"
  },
  "autoload": {
    "psr-4": { "FakePsp\\": "src/" }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": { "php-http/discovery": true, "tbachert/spi": true }
  }
}
