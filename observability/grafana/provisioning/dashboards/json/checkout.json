{
  "uid": "checkout",
  "title": "Checkout",
  "tags": ["workshop"],
  "schemaVersion": 41,
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Checkouts / s",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(traces_span_metrics_calls_total{service_name=\"gateway\", span_kind=\"SPAN_KIND_SERVER\", span_name=\"POST /checkout\"}[1m]))"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 1 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "area" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Checkout error rate",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(traces_span_metrics_calls_total{service_name=\"gateway\", span_kind=\"SPAN_KIND_SERVER\", span_name=\"POST /checkout\", status_code=\"STATUS_CODE_ERROR\"}[1m])) / sum(rate(traces_span_metrics_calls_total{service_name=\"gateway\", span_kind=\"SPAN_KIND_SERVER\", span_name=\"POST /checkout\"}[1m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.01 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" }
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Orders by status (database, last 15 min)",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "postgres" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT status, count(*) AS orders FROM orders WHERE $__timeFilter(created_at) GROUP BY status ORDER BY status"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": true }, "orientation": "horizontal", "displayMode": "basic" }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Checkout latency p50 / p95 / p99 (click an exemplar ◆ to open its trace)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p50",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=\"gateway\", span_kind=\"SPAN_KIND_SERVER\", span_name=\"POST /checkout\"}[1m])))"
        },
        {
          "refId": "B",
          "legendFormat": "p95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=\"gateway\", span_kind=\"SPAN_KIND_SERVER\", span_name=\"POST /checkout\"}[1m])))"
        },
        {
          "refId": "C",
          "legendFormat": "p99",
          "exemplar": true,
          "expr": "histogram_quantile(0.99, sum by (le) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=\"gateway\", span_kind=\"SPAN_KIND_SERVER\", span_name=\"POST /checkout\"}[1m])))"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "lineWidth": 2 } }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "heatmap",
      "title": "Checkout latency heatmap",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "exemplar": true,
          "expr": "sum by (le) (increase(traces_span_metrics_duration_milliseconds_bucket{service_name=\"gateway\", span_kind=\"SPAN_KIND_SERVER\", span_name=\"POST /checkout\"}[1m]))"
        }
      ],
      "options": {
        "calculate": false,
        "yAxis": { "unit": "ms" },
        "color": { "mode": "scheme", "scheme": "Oranges", "scale": "exponential" },
        "cellGap": 1,
        "exemplars": { "color": "rgba(80,160,255,0.9)" }
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "RED per service (server spans, last 5 min)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "instant": true,
          "expr": "sum by (service_name) (rate(traces_span_metrics_calls_total{span_kind=\"SPAN_KIND_SERVER\"}[5m]))"
        },
        {
          "refId": "B",
          "format": "table",
          "instant": true,
          "expr": "sum by (service_name) (rate(traces_span_metrics_calls_total{span_kind=\"SPAN_KIND_SERVER\", status_code=\"STATUS_CODE_ERROR\"}[5m])) / sum by (service_name) (rate(traces_span_metrics_calls_total{span_kind=\"SPAN_KIND_SERVER\"}[5m]))"
        },
        {
          "refId": "C",
          "format": "table",
          "instant": true,
          "expr": "histogram_quantile(0.95, sum by (service_name, le) (rate(traces_span_metrics_duration_milliseconds_bucket{span_kind=\"SPAN_KIND_SERVER\"}[5m])))"
        }
      ],
      "transformations": [
        { "id": "merge" },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": { "service_name": "Service", "Value #A": "Rate (req/s)", "Value #B": "Errors", "Value #C": "p95 (ms)" }
          }
        }
      ],
      "fieldConfig": {
        "defaults": { "decimals": 2 },
        "overrides": [{ "matcher": { "id": "byName", "options": "Errors" }, "properties": [{ "id": "unit", "value": "percentunit" }] }]
      }
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Error logs (all services)",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 22 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service_name=~\".+\"} | severity_text=~\"(?i)error|fatal\""
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" }
    }
  ]
}
