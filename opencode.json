{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "allow",
      "services/**": "deny",
      "observability/**": "deny",
      "scenarios/**": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "labs/*/SOLUTION.md": "deny",
      "docs/02-defects-catalog.md": "deny",
      "docs/authoring/**": "deny",
      "scenarios/incident-5/**": "deny"
    },
    "bash": {
      "*": "allow",
      "make solution*": "deny",
      "sh scripts/jump.sh solution*": "deny",
      "git * lab-*-solution*": "deny",
      "git * solution/lab-*": "deny",
      "git apply*": "deny",
      "*scenarios/incident-5*": "deny",
      "*SOLUTION.md*": "deny"
    },
    "grafana_*": "deny"
  },
  "mcp": {
    "grafana": {
      "type": "local",
      "command": ["docker", "compose", "--profile", "ai", "run", "--rm", "-i", "-T", "mcp-grafana"],
      "enabled": false
    }
  }
}
