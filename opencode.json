{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "scenarios/incident-5/**": "deny",
      "docs/02-defects-catalog.md": "deny",
      "labs/05-ai-mcp/INSTRUCTOR.md": "deny",
      "labs/05-ai-mcp/SOLUTION.md": "deny"
    },
    "bash": {
      "*": "ask",
      "*scenarios/incident-5*": "deny",
      "*docs/02-defects-catalog*": "deny",
      "*labs/05-ai-mcp/INSTRUCTOR*": "deny",
      "*labs/05-ai-mcp/SOLUTION*": "deny"
    }
  },
  "mcp": {
    "grafana": {
      "type": "local",
      "command": [
        "docker",
        "compose",
        "--profile",
        "ai",
        "run",
        "--rm",
        "-i",
        "-T",
        "mcp-grafana"
      ],
      "enabled": true
    }
  }
}
